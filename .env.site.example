# TEMPLATE ONLY: no production values have been confirmed.
# Enable only after all required metadata is confirmed. CI needs repository vars.
# Only plain X.Y.Z macOS/Windows client releases are supported; no Linux/cjq/RC.
SUB2API_SITE_RELEASE=0
# Current site artifact naming limit: ASCII [A-Za-z][A-Za-z0-9_-]* only.
# Product name is used directly in DMG/installer/feed filenames; no spaces or Unicode.
# Publisher and platform data directory still allow safe Unicode and spaces.
SUB2API_BRAND_NAME=
SUB2API_BRAND_BUNDLE_ID=
SUB2API_BRAND_WEBSITE=
SUB2API_MANAGED_SERVICE_URL=
SUB2API_MANAGED_SERVICE_ALT_URLS=
SUB2API_RELEASES_BASE_URL=
SUB2API_DATA_DIR_NAME=
SUB2API_PLATFORM_DATA_DIR_NAME=
# Windows: own stable GUID without braces; never reuse previous installer ID.
SUB2API_WINDOWS_APP_ID=
SUB2API_PUBLISHER=
# PUBLIC key only: canonical base64, 32-byte Ed25519, owned by this site.
# Never store private keys in this example or any tracked file.
SUB2API_SPARKLE_PUBLIC_KEY=
# Optional development-only identity/storage; releases use non-debug variables.
SUB2API_BRAND_BUNDLE_ID_DEBUG=
SUB2API_PLATFORM_DATA_DIR_NAME_DEBUG=
# Legacy migration remains off unless explicitly consented to.
SUB2API_ALLOW_LEGACY_STORAGE_MIGRATION=0
# Site WAKU_DOWNLOAD_URL_PREFIX may only equal releases base + '/'.
# Site release.ts requires --local; sync-release is the exclusive publisher.
# Own signing private key stays a controlled CI SPARKLE_PRIVATE_KEY secret,
# never a repository var. Site signing disables legacy keychain fallback.
